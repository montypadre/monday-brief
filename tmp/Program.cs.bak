using System.Globalization;
using System.Text;
using MondayBrief.Seed;

// Usage: dotnot run --project src/MondayBrief.Seed [-- --out <dir>] [--seed <number>] [--find-seed <tries>]
// Writes the raw source files plus SEED_CHECK.md. Exits 1 if any planted-event check fails.
// --find-seed searches upward from --seed for one where every check passes (no files written).


var outDir = ArgValue(args, "--out") ?? Path.Combine(FindRepoRoot(), "data", "raw");
var seed = ulong.Parse(ArgValue(args, "--seed") ?? PlantedEvents.DefaultSeed.ToString(CultureInfo.InvariantCulture), CultureInfo.InvariantCulture);
var zone = TimeZoneInfo.FindSystemTimeZoneById(PlantedEvents.TimeZoneId);

if (ArgValue(args, "--find-seed") is { } triesText)
{
    var tries = int.Parse(triesText, CultureInfo.InvariantCulture);
    for (var candidate = seed; candidate < seed + (ulong)tries; candidate++)
    {
        var failed = new SeedChecks(new Generator(new SeededRng(candidate)).Run()).Run().Count(c => !c.Passed);
        Console.WriteLine($"seed {candidate}: {(failed == 0 ? "all checks pass" : $"{failed} failed")}");
        if (failed == 0)
        {
            Console.WriteLine($"Use: --seed {candidate} (or update PlantedEvents.DefaultSeed)");
            return 0;
        }
    }

    Console.WriteLine("No passing seed found. Loosen the demand model before trying more seeds.");
    return 1;
}

Directory.CreateDirectory(outDir);
var simulation = new Generator(new SeededRng(seed)).Run();

SourceWriters.WritePosCatalog(outDir);
SourceWriters.WritePosTransactions(outDir, simulation.Orders);
SourceWriters.WriteEcommerceOrders(outDir, simulation.Orders, zone);
SourceWriters.WriteAnalytics(outDir, simulation.Traffic);

var checks = new SeedChecks(simulation);
var results = checks.Run();

var report = new StringBuilder();
report.AppendLine("# Seed check");
report.AppendLine();
report.AppendLine(CultureInfo.InvariantCulture, $"Seed `{seed}` · {PlantedEvents.DataStart:yyyy-MM-dd} to {PlantedEvents.DataEnd:yyyy-MM-dd} · as-of {PlantedEvents.AsOfDate:yyyy-MM-dd}");
report.AppendLine();
report.AppendLine(checks.Summary());
report.AppendLine("| Event | Check | Result | Pass |");
report.AppendLine("|---|---|---|:---:|");
foreach (var r in results)
{
    report.AppendLine(CultureInfo.InvariantCulture, $"| {r.Event} | {r.Check} | {r.Detail} | {(r.Passed ? "✅" : "❌")} |");
}

var passed = results.Count(r => r.Passed);
report.AppendLine();
report.AppendLine(CultureInfo.InvariantCulture, $"**{passed}/{results.Count} checks passed.**");

File.WriteAllText(Path.Combine(outDir, "SEED_CHECK.md"), report.ToString(), new UTF8Encoding(false));
Console.OutputEncoding = Encoding.UTF8;
Console.WriteLine(report.ToString());
Console.WriteLine($"Files written to {Path.GetFullPath(outDir)}");

return passed == results.Count ? 0 : 1;
static string? ArgValue(string[] args, string name)
{
    var i = Array.IndexOf(args, name);
    return i >= 0 && i + 1 < args.Length ? args[i + 1] : null;
}

static string FindRepoRoot()
{
    for (var dir = new DirectoryInfo(Directory.GetCurrentDirectory()); dir is not null; dir = dir.Parent)
    {
        if (dir.GetFiles("MondayBrief.sln").Length > 0 || dir.GetFiles("MondayBrief.slnx").Length > 0)
        {
            return dir.FullName;
        }
    }

    return Directory.GetCurrentDirectory();
}